# ClassRelay — environment configuration
#
# Everything below is OPTIONAL. With no keys at all, ClassRelay runs in Demo Mode:
# a fully interactive, clearly-labelled simulation of the classroom, quiz, report and
# peer-learning flow. Add a key to switch the AI features to a real model.

# ---- Which provider to use -------------------------------------------------
# Leave empty to auto-detect (first key found wins). One of: groq | openai | gemini
AI_PROVIDER=

# ---- Groq (fast, OpenAI-compatible) ----------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# How long the class may take to raise a hand before the instant demo engine steps in.
# Hosted Groq answers well inside the default; raise it for a slow or self-hosted model.
CLASS_TURN_TIMEOUT_MS=12000

# ---- OpenAI-compatible provider --------------------------------------------
# Works with OpenAI, Featherless, OpenRouter, Groq, Together, vLLM, Ollama, and any
# other endpoint that speaks the /chat/completions format.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Google Gemini ----------------------------------------------------------
# Used for text tasks and, optionally, for voice transcription fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Server -----------------------------------------------------------------
# Port for the API + static server (npm start / npm run dev).
API_PORT=8787
# Set to 0.0.0.0 to allow other devices on your network to reach the API.
API_HOST=127.0.0.1
